{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "oneaura-landing",
  "compatibility_date": "2026-10-06",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  },
  // Only www — never a wildcard on oneaura.app, which also carries
  // admin.oneaura.app and the per-academy *.oneaura.app subdomains
  // belonging to the main oneaura project.
  "routes": [
    { "pattern": "www.oneaura.app/*", "zone_name": "oneaura.app" }
  ]
}
